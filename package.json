{
  "name": "@adaptive-ds/minimax",
  "version": "0.1.1",
  "main": "dist/index.js",
  "peerDependencies": {
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "description": "MiniMax coding-plan client utilities for TypeScript and Bun projects.",
  "files": [
    "dist"
  ],
  "keywords": [
    "minimax",
    "typescript",
    "bun",
    "ai",
    "search",
    "vision"
  ],
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "private": false,
  "scripts": {
    "build": "rm -rf ./dist && bun tsc -p ./tsconfig.lib.json",
    "minimaxSearch": "bun run ./src/cli/minimaxSearch.ts",
    "minimaxUnderstandImage": "bun run ./src/cli/minimaxUnderstandImage.ts",
    "demo": "bun --env-file=.env run ./test/demoMinimaxCodingPlan.cli.ts",
    "test": "bun test --env-file .env",
    "test:w": "bun test --env-file .env --watch",
    "release": "bash ./ops/release.sh",
    "update": "bun update",
    "update:commit": "bun update && git add package.json && bun run tsc && git commit -m \"chore(deps): update dependencies\" && git push",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules",
    "format": "biome format --write src test package.json tsconfig.json tsconfig.lib.json biome.json"
  },
  "type": "module",
  "bin": {
    "minimaxSearch": "./src/cli/minimaxSearch.ts",
    "minimaxUnderstandImage": "./src/cli/minimaxUnderstandImage.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.ts"
}
